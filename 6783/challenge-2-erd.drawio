<mxfile host="app.diagrams.net" modified="2026-09-15T08:51:20.807984Z" agent="OpenAI" version="24.7.17"><diagram id="erd-1" name="ERD"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="چالش ۲ - ERD فروشگاه آنلاین پوشاک با Integrity و Audit" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="450" y="20" width="1000" height="45" as="geometry" /></mxCell><mxCell id="customer" value="&lt;b&gt;CUSTOMER&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; customer_id BIGINT&lt;br&gt;email VARCHAR(254) UQ NN&lt;br&gt;full_name VARCHAR(150) NN&lt;br&gt;created_at DATETIME NN" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=12;fontFamily=Arial;strokeColor=#444444;fillColor=#ffffff;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="300" height="170" as="geometry" /></mxCell><mxCell id="order" value="&lt;b&gt;ORDER&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; order_id BIGINT&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; customer_id BIGINT NN&lt;br&gt;status VARCHAR(20) NN&lt;br&gt;gross_amount DECIMAL(12,2) NN CHECK &amp;gt;= 0&lt;br&gt;discount_amount DECIMAL(12,2) NN CHECK &amp;gt;= 0&lt;br&gt;final_amount DECIMAL(12,2) NN CHECK &amp;gt;= 0&lt;br&gt;created_at DATETIME NN" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=12;fontFamily=Arial;strokeColor=#444444;fillColor=#ffffff;spacing=8;" vertex="1" parent="1"><mxGeometry x="465" y="105" width="355" height="245" as="geometry" /></mxCell><mxCell id="orderitem" value="&lt;b&gt;ORDER_ITEM&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; order_item_id BIGINT&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; order_id BIGINT NN&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; variant_id BIGINT NN&lt;br&gt;quantity INT NN CHECK &amp;gt; 0&lt;br&gt;unit_price_at_purchase DECIMAL(12,2) NN CHECK &amp;gt;= 0&lt;br&gt;line_discount_amount DECIMAL(12,2) NN CHECK &amp;gt;= 0&lt;br&gt;line_total DECIMAL(12,2) NN CHECK &amp;gt;= 0&lt;br&gt;sku_at_purchase VARCHAR(40) NN" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=12;fontFamily=Arial;strokeColor=#444444;fillColor=#ffffff;spacing=8;" vertex="1" parent="1"><mxGeometry x="465" y="430" width="355" height="270" as="geometry" /></mxCell><mxCell id="product" value="&lt;b&gt;PRODUCT&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; product_id BIGINT&lt;br&gt;product_code VARCHAR(40) UQ NN&lt;br&gt;name VARCHAR(150) NN&lt;br&gt;model VARCHAR(100) NN&lt;br&gt;base_price DECIMAL(12,2) NN CHECK &amp;gt;= 0&lt;br&gt;is_active BOOLEAN NN&lt;br&gt;created_at DATETIME NN&lt;br&gt;updated_at DATETIME NN" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=12;fontFamily=Arial;strokeColor=#444444;fillColor=#ffffff;spacing=8;" vertex="1" parent="1"><mxGeometry x="1030" y="100" width="340" height="250" as="geometry" /></mxCell><mxCell id="variant" value="&lt;b&gt;PRODUCT_VARIANT&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; variant_id BIGINT&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; product_id BIGINT NN&lt;br&gt;sku VARCHAR(40) UQ NN&lt;br&gt;size VARCHAR(20) NN&lt;br&gt;color VARCHAR(50) NN&lt;br&gt;stock_qty INT NN CHECK &amp;gt;= 0&lt;br&gt;is_active BOOLEAN NN&lt;br&gt;UQ(product_id, size, color)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=12;fontFamily=Arial;strokeColor=#444444;fillColor=#ffffff;spacing=8;" vertex="1" parent="1"><mxGeometry x="1030" y="425" width="340" height="245" as="geometry" /></mxCell><mxCell id="discount" value="&lt;b&gt;DISCOUNT&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; discount_id BIGINT&lt;br&gt;code VARCHAR(40) UQ NN&lt;br&gt;discount_type VARCHAR(10) NN&lt;br&gt;discount_value DECIMAL(12,2) NN CHECK &amp;gt; 0&lt;br&gt;starts_at DATETIME NN&lt;br&gt;ends_at DATETIME NN&lt;br&gt;is_active BOOLEAN NN&lt;br&gt;CHECK starts_at &amp;lt; ends_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=12;fontFamily=Arial;strokeColor=#444444;fillColor=#ffffff;spacing=8;" vertex="1" parent="1"><mxGeometry x="1510" y="100" width="330" height="245" as="geometry" /></mxCell><mxCell id="discountproduct" value="&lt;b&gt;DISCOUNT_PRODUCT&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK/FK&lt;/b&gt; discount_id BIGINT&lt;br&gt;&lt;b&gt;PK/FK&lt;/b&gt; product_id BIGINT" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=12;fontFamily=Arial;strokeColor=#444444;fillColor=#ffffff;spacing=8;" vertex="1" parent="1"><mxGeometry x="1475" y="430" width="330" height="120" as="geometry" /></mxCell><mxCell id="itemdiscount" value="&lt;b&gt;ORDER_ITEM_DISCOUNT&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK/FK&lt;/b&gt; order_item_id BIGINT&lt;br&gt;&lt;b&gt;PK/FK&lt;/b&gt; discount_id BIGINT&lt;br&gt;applied_amount DECIMAL(12,2) NN CHECK &amp;gt;= 0" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=12;fontFamily=Arial;strokeColor=#444444;fillColor=#ffffff;spacing=8;" vertex="1" parent="1"><mxGeometry x="1475" y="670" width="330" height="145" as="geometry" /></mxCell><mxCell id="audit" value="&lt;b&gt;AUDIT_LOG&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; audit_id BIGINT&lt;br&gt;entity_type VARCHAR(40) NN&lt;br&gt;entity_id BIGINT NN&lt;br&gt;action VARCHAR(20) NN&lt;br&gt;changed_by VARCHAR(100) NN&lt;br&gt;changed_at DATETIME NN&lt;br&gt;old_values JSON NN&lt;br&gt;new_values JSON NN" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=12;fontFamily=Arial;strokeColor=#444444;fillColor=#ffffff;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="765" width="340" height="250" as="geometry" /></mxCell><mxCell id="auditnote" value="AuditLog عمومی است و برای Product / ProductVariant / Discount / Order تغییرات را ثبت می‌کند؛ FK مستقیم ندارد تا چند 