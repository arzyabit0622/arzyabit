{
  "info": {
    "_postman_id": "7f5d7f3c-c2d0-4bda-9f17-qa-sdet-exam",
    "name": "Event Ticket Stateful API Tests",
    "description": "Stateful integration tests for reservation, payment, confirmation, cancellation, capacity and error handling. Dynamic IDs are dual-written to the selected environment and to dedicated collection runtime variables, so the workflow also works in Scratch Pad when no environment is active.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Get Events",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/events",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "events"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test('Events response is a non-empty array', () => { pm.expect(data).to.be.an('array'); pm.expect(data.length).to.be.above(0); });",
              "const firstEvent = Array.isArray(data) && data.length ? data[0] : null;",
              "pm.test('First event has id and capacity', () => { pm.expect(firstEvent).to.be.an('object'); pm.expect(firstEvent).to.have.property('id'); pm.expect(firstEvent).to.have.property('capacity'); });",
              "if (firstEvent) {",
              "  pm.collectionVariables.set('rtEventId', String(firstEvent.id));",
              "  pm.collectionVariables.set('rtEventCapacity', String(firstEvent.capacity));",
              "  try { pm.environment.set('eventId', String(firstEvent.id)); } catch (e) {}",
              "  try { pm.environment.set('eventCapacity', String(firstEvent.capacity)); } catch (e) {}",
              "}",
              "console.log('Runtime eventId:', pm.collectionVariables.get('rtEventId'));",
              "console.log('Environment eventId:', pm.environment.get('eventId'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
